{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/analysis-result.schema.json",
  "title": "Strict Target Analysis Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "normalizedRequirement", "evidence", "assetCandidates", "a2aContracts", "runtimeContracts", "graph"],
  "properties": {
    "contract_version": { "const": "2.0" },
    "normalizedRequirement": { "$ref": "./normalized-requirement.schema.json" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "assetCandidates": { "type": "array", "items": { "$ref": "./asset-candidate.schema.json" } },
    "a2aContracts": { "type": "array", "items": { "$ref": "./a2a-contract.schema.json" } },
    "runtimeContracts": { "type": "array", "items": { "$ref": "#/$defs/runtimeContract" } },
    "graph": { "$ref": "./graph.schema.json" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_goal", "business_domain_hint", "user_role", "input_data", "output_data", "systems_mentioned", "decisions_implied", "risk_signals", "missing_information", "contradictions", "assumptions"],
      "properties": {
        "requested_goal": { "type": "string", "minLength": 1 },
        "business_domain_hint": { "type": "string", "minLength": 1 },
        "user_role": { "type": "string", "minLength": 1 },
        "input_data": { "$ref": "#/$defs/stringArray" },
        "output_data": { "$ref": "#/$defs/stringArray" },
        "systems_mentioned": { "$ref": "#/$defs/stringArray" },
        "decisions_implied": { "$ref": "#/$defs/stringArray" },
        "risk_signals": { "type": "array", "items": { "$ref": "#/$defs/riskSignal" } },
        "missing_information": { "$ref": "#/$defs/stringArray" },
        "contradictions": { "$ref": "#/$defs/stringArray" },
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "accepted_missing_information": { "$ref": "#/$defs/stringArray" }
      }
    },
    "runtimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_kind", "asset_id", "title", "contract_status", "summary", "required_review_fields", "reviewer_notes", "runtime_support", "operation", "identifiers", "policies", "graph_ir_annotations", "synthetic_examples", "developer_todos"],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 },
        "contract_kind": { "type": "string", "enum": ["mcp_connection", "external_connection", "context_manager", "callback_broker", "adk_callback", "async_resume"] },
        "asset_id": { "$ref": "#/$defs/nullableString" },
        "title": { "type": "string", "minLength": 1 },
        "contract_status": { "type": "string", "enum": ["draft", "needs_info", "approved", "rejected"] },
        "summary": { "type": "string", "minLength": 1 },
        "required_review_fields": { "$ref": "#/$defs/stringArray" },
        "reviewer_notes": { "type": "string" },
        "runtime_support": { "$ref": "#/$defs/runtimeSupport" },
        "operation": { "$ref": "#/$defs/runtimeOperation" },
        "identifiers": { "$ref": "#/$defs/stringArray" },
        "policies": { "$ref": "#/$defs/runtimePolicies" },
        "resume_policy": { "oneOf": [{ "$ref": "#/$defs/asyncResumePolicy" }, { "type": "null" }] },
        "side_effect_guard": { "oneOf": [{ "$ref": "#/$defs/asyncResumeSideEffectGuard" }, { "type": "null" }] },
        "graph_ir_annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "synthetic_examples": { "type": "array", "items": { "type": "object" } },
        "developer_todos": { "$ref": "#/$defs/stringArray" }
      },
      "allOf": [
        {
          "if": { "properties": { "contract_kind": { "const": "async_resume" } }, "required": ["contract_kind"] },
          "then": { "required": ["resume_policy", "side_effect_guard"] }
        }
      ]
    },
    "runtimeSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_manager_required", "callback_broker_required", "human_approval_required", "idempotency_required", "audit_required", "compensation_required"],
      "properties": {
        "context_manager_required": { "type": "boolean" },
        "callback_broker_required": { "type": "boolean" },
        "human_approval_required": { "type": "boolean" },
        "idempotency_required": { "type": "boolean" },
        "audit_required": { "type": "boolean" },
        "compensation_required": { "type": "boolean" }
      }
    },
    "runtimeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_type", "side_effect_level", "callback_expected", "async_resume_required"],
      "properties": {
        "operation_type": { "type": "string", "enum": ["read", "write", "approval", "batch", "notification", "unknown"] },
        "side_effect_level": { "type": "string", "enum": ["none", "read_only", "write", "financial_write", "customer_notification", "unknown"] },
        "callback_expected": { "type": "boolean" },
        "async_resume_required": { "type": "boolean" }
      }
    },
    "runtimePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_policy", "timeout_policy", "retry_policy", "fallback_policy", "masking_policy", "data_policy"],
      "properties": {
        "auth_policy": { "type": "string" },
        "timeout_policy": { "type": "string" },
        "retry_policy": { "type": "string" },
        "fallback_policy": { "type": "string" },
        "masking_policy": { "type": "string" },
        "data_policy": { "type": "string" }
      }
    },
    "asyncResumePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interrupt_id", "correlation_scope", "timeout_seconds", "on_timeout", "duplicate_response", "conflicting_response", "restart_policy"],
      "properties": {
        "interrupt_id": { "type": "string", "minLength": 1 },
        "correlation_scope": { "const": "invocation" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "on_timeout": { "const": "expire_without_side_effect" },
        "duplicate_response": { "const": "return_recorded_result" },
        "conflicting_response": { "const": "reject" },
        "restart_policy": { "const": "resume_incomplete_replay_completed" }
      }
    },
    "asyncResumeSideEffectGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_ref", "idempotency_key_input", "delivery_semantics", "ledger_scope"],
      "properties": {
        "tool_ref": { "type": "string", "minLength": 1 },
        "idempotency_key_input": { "type": "string", "minLength": 1 },
        "delivery_semantics": { "const": "at_most_once" },
        "ledger_scope": { "const": "session_state" }
      }
    },
    "riskSignal": {
      "type": "string",
      "enum": ["personal_data", "financial_data", "credit_decision_support", "customer_impact", "external_message", "transaction_write", "human_approval_required", "audit_required"]
    },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nullableString": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
  }
}
