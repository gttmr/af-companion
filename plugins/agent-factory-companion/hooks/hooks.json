{
  "description": "Portable bootstrap for lease-gated Agent Factory Codex activity projection and next-prompt context delivery. Matching Hook definitions remain additive.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/af-codex-hook-entry.mjs\"",
            "timeout": 1,
            "statusMessage": "Agent Factory Session 연결 확인"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/af-codex-hook-entry.mjs\"",
            "timeout": 1,
            "statusMessage": "Agent Factory Context 확인"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/af-codex-hook-entry.mjs\"",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/af-codex-hook-entry.mjs\"",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/af-codex-hook-entry.mjs\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
