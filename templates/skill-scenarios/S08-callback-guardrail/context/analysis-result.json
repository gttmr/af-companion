      ],
      "policies": {
        "auth_policy": "Accept only fixed synthetic requests in the isolated scenario; production identity and authorization are out of scope.",
        "timeout_policy": "A missing or late callback decision is blocked before Tool invocation.",
        "retry_policy": "Repeated evaluation of the same synthetic request must be deterministic, and a blocked request must never invoke the Tool.",
        "fallback_policy": "Callback exception, missing decision, or invalid decision returns the typed blocked override and does not invoke the Tool.",
        "masking_policy": "Persist only the synthetic request ID, normalized allow or block decision, and reason code; never persist raw prompt, Tool arguments, or secrets.",
        "data_policy": "Fixed synthetic payloads and identifiers only; no actor, customer, credential, or private endpoint data."
